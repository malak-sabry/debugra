# ─── LLM Providers ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Ollama (local) — used for action selection (high-frequency)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Primary/fallback model routing
LLM_PLANNER=claude-sonnet-4-5        # planning + report synthesis
LLM_ACTOR=ollama/llama3.1:8b         # action selection (local)
LLM_REPORTER=claude-sonnet-4-5       # finding summarization

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://debugra:debugra@localhost:5432/debugra
REDIS_URL=redis://localhost:6379/0

# ─── Orchestrator ───────────────────────────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
SECRET_KEY=change-me-in-production

# ─── Agent Runner ───────────────────────────────────────────────────────────
AGENT_STEP_LIMIT=40
AGENT_WALL_CLOCK_SECONDS=300
PLAYWRIGHT_HEADLESS=true
ARTIFACTS_DIR=./runs

# ─── SUTs ───────────────────────────────────────────────────────────────────
LMS_BASE_URL=http://localhost:3001
LMS_API_URL=http://localhost:8001
SHOP_BASE_URL=http://localhost:3002
SHOP_API_URL=http://localhost:8002
