# ─── LLM Providers ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Hack Club OpenAI-compatible proxy
HACKCLUB_API_KEY=sk-hc-v1-...
HACKCLUB_BASE_URL=https://ai.hackclub.com/proxy/v1

# Ollama (local) — used for action selection (high-frequency)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Primary/fallback model routing
LLM_PLANNER=claude-sonnet-4-5        # planning + report synthesis; e.g. x-ai/grok-build-0.1 via Hack Club
LLM_ACTOR=ollama/llama3.1:8b         # action selection; e.g. x-ai/grok-build-0.1 via Hack Club
LLM_REPORTER=claude-sonnet-4-5       # finding summarization; e.g. x-ai/grok-build-0.1 via Hack Club

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://debugra:debugra@localhost:5432/debugra
REDIS_URL=redis://localhost:6379/0

# ─── Orchestrator ───────────────────────────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
SECRET_KEY=change-me-in-production

# ─── Agent Runner ───────────────────────────────────────────────────────────
AGENT_STEP_LIMIT=40
AGENT_WALL_CLOCK_SECONDS=300
PLAYWRIGHT_HEADLESS=true
ARTIFACTS_DIR=./runs

# ─── SUTs ───────────────────────────────────────────────────────────────────
LMS_BASE_URL=http://localhost:3001
LMS_API_URL=http://localhost:8001
SHOP_BASE_URL=http://localhost:3002
SHOP_API_URL=http://localhost:8002
